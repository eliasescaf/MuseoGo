# Base de datos PostgreSQL / Supabase
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Groq (https://console.groq.com/keys)
# Plan gratuito: 30 req/min, 1.000 req/día, 8K tokens/min, 200K tokens/día.
GROQ_API_KEY=""
# Alternativas con JSON estricto: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL="openai/gpt-oss-120b"

# Puntaje mínimo para considerar correcta una respuesta abierta
AI_UMBRAL_APROBACION=60
